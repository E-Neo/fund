package fund:strategy;

interface fees {
    /// Redemption fee the platform would charge to redeem `shares` now.
    redeem-fee: func(shares: f64) -> f64;
    /// Subscription fee the platform would charge to invest `amount`.
    subscribe-fee: func(amount: f64) -> f64;
}

interface trader {
    record nav-update {
        date: string,
        unit-nav: f64,
        accum-nav: f64,
    }

    record invest-executed {
        amount: f64,
        shares: f64,
        fee: f64,
    }

    record redeem-executed {
        shares: f64,
        money: f64,
        fee: f64,
    }

    variant transaction-kind {
        invest(invest-executed),
        redeem(redeem-executed),
    }

    record order-executed {
        date: string,
        unit-nav: f64,
        kind: transaction-kind,
    }

    variant event {
        nav-update(nav-update),
        order-executed(order-executed),
    }

    variant order {
        invest(f64),
        redeem(f64),
    }

    name: func() -> string;
    description: func() -> string;
    config-schema: func() -> string;
    init: func(config: string) -> result<_, string>;
    on-event: func(event: event) -> list<order>;
}

world fund-strategy {
    import fees;
    export trader;
}
